{
  "expo": {
    "name": "Financeiro Mobile",
    "slug": "financeiro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.financeiro.mobile"
    },
    "android": {
      "package": "com.financeiro.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png.png",
        "backgroundColor": "#1C1C1E"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "977054bd-f29d-4c24-bb49-4f7ff15fd24b"
      }
    },
    "owner": "emanuel-git-bot"
  }
}
